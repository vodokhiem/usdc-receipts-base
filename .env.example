# Base mainnet RPC with an API key. Required for ingest and balances.
# Public endpoints (mainnet.base.org) rate-limit eth_getLogs and will fail.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>

# Postgres connection string (Neon, Supabase, RDS, ...).
# Leave unset to use the embedded PGlite database in ./data/pglite (local dev only).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Shared secret for /api/ingest. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me

# Optional tuning (defaults shown)
# CONFIRMATIONS=12
# REORG_OVERLAP=32
# LOOKBACK_BLOCKS=50000
# CHUNK_BLOCKS=2000
