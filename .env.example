# Base mainnet RPC with an API key. Required for ingest and balances.
# Public endpoints (mainnet.base.org) rate-limit eth_getLogs and will fail.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>

# Postgres connection string (Neon, Supabase, RDS, ...). Required in production.
# Leave unset locally to use the embedded PGlite database in ./data/pglite.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Shared secret for /api/ingest. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me

# Optional tuning (defaults shown)
# HEAD_TAG=safe                 # latest | safe | finalized — how deep a block must be before it is stored
# CONFIRMATIONS=0               # extra blocks below HEAD_TAG
# REORG_OVERLAP=32              # blocks re-checked (and reconciled) on every run
# LOOKBACK_BLOCKS=50000         # first scan depth per address (~28 h)
# CHUNK_BLOCKS=2000             # eth_getLogs range per call
# INGEST_TIME_BUDGET_MS=40000   # one cron run stops starting new addresses after this
# MAX_WATCHED=20                # cap on addresses anyone can add from the UI
# ALLOW_PGLITE=1                # let `next start` use PGlite locally (never set this on a real deployment)
